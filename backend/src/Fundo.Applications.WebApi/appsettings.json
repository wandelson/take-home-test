{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "EnableSwagger": false,
  "Database": {
    "Provider": "SqlServer",
    "InMemoryName": "FundoLoans"
  },
  "Jwt": {
    "Issuer": "FundoLoanApi",
    "Audience": "FundoLoanClient",
    "Key": "",
    "ExpiresMinutes": 60
  },
  "Auth": {
    "Username": "",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Observability": {
    "ServiceName": "FundoLoanApi",
    "EnableTracing": true,
    "EnableConsoleExporter": false
  }
}
