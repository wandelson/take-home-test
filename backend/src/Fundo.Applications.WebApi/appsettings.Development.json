{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "EnableSwagger": true,
  "Database": {
    "Provider": "InMemory",
    "InMemoryName": "FundoLoansDev"
  },
  "Jwt": {
    "Issuer": "FundoLoanApi",
    "Audience": "FundoLoanClient",
    "Key": "SuperSecretDemoKeyThatIsAtLeast32CharactersLong!",
    "ExpiresMinutes": 60
  },
  "Auth": {
    "Username": "admin",
    "Password": "admin123"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=FundoLoans;User Id=sa;Password=Your_password123;TrustServerCertificate=True;"
  },
  "Observability": {
    "EnableTracing": true,
    "EnableConsoleExporter": true
  }
}
